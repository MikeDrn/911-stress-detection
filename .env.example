# Copy to `.env` (docker compose reads it automatically) and adjust.

# auto   = load MLflow models:/voice-stress-detector@champion, fall back to models/champion.pt
# mlflow = registry only | file = models/champion.pt only
# fake   = FakeModel test double (demo the stack before any training; scores are NOT real)
MODEL_SOURCE=auto

# Artificial weight-loading delay so the 503 -> 200 readiness transition is visible in demos.
MODEL_LOAD_DELAY_SECONDS=5

# Only used when MODEL_SOURCE=fake, e.g. "0.1,0.2,0.9,0.95,0.97,0.9,0.3"
FAKE_SCORES=

# macOS: port 5000 is often taken by AirPlay Receiver. Change to 5001 here AND
# set MLFLOW_TRACKING_URI=http://localhost:5001 before training on the host.
MLFLOW_HOST_PORT=5000
